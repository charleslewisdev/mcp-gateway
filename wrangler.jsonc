{
  "name": "mcp-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ],

  // Hosts allowed to receive authorization codes. Add a client's host here to let it connect.
  "vars": {
    "ALLOWED_REDIRECT_HOSTS": "claude.ai,claude.com,localhost,127.0.0.1"
  },

  // Password attempts per minute, per address and across all addresses.
  // Counters are per Cloudflare location, so the limits are approximate.
  "ratelimits": [
    {
      "name": "LOGIN_IP_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "LOGIN_GLOBAL_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ]

  // Custom domain (deployment-specific) — uncomment and set your own:
  // "routes": [
  //   { "pattern": "mcp.example.com/*", "zone_name": "example.com" }
  // ]

  // Environment variables (set via `wrangler secret put`):
  //   USERNAME        - login username
  //   PASSWORD_HASH   - bcrypt hash of login password
  //   BACKENDS        - JSON object mapping path prefixes to backend configs
  //                     e.g. {"bramble":{"url":"https://bramble.example.com","token":"brk_xxx"}}
}
